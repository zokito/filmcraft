{
  "$comment": "Role `implementer` for craft workers. Launch: .agents/launch.sh <SID>. Adapted from hdb-books .claude/roles/implementer.json. Push/PR targets are enforced by .agents/guard.py (word-boundary prefix rules cannot express agents/<SID>).",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(crates/**)",
      "Write(crates/**)",
      "Edit(apps/**)",
      "Write(apps/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(README.md)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo xtask:*)",
      "Bash(target/release/filmcraft-cli:*)",
      "Bash(./target/release/filmcraft-cli:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(sed -n:*)",
      "Bash(time:*)",
      "Bash(python3 .agents/guard.py:*)",
      "Bash(python3 /Users/zokito/Development/claude-plugins/plugins/worklog/tools/worklog.py:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh auth status:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(printenv:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.p12)",
      "Read(**/token*.json)",
      "Bash(security:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push upstream:*)",
      "Bash(rm -rf:*)",
      "WebFetch",
      "WebSearch",
      "Edit(.agents/**)",
      "Write(.agents/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(/Cargo.lock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/guard.py"
          }
        ]
      }
    ]
  }
}
